# Copy to .env.prod and fill in all values before first deploy.
# Generate FLASK_SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Database ──────────────────────────────────────────────────────────────────
# Must match the password set for the agritwin DB user in Phase 3 of ROADMAP.md.
# The full DATABASE_URL is assembled in docker-compose.prod.yml using this value.
AGRITWIN_DB_PASSWORD=change-me-strong-password

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-64-random-hex-chars
FLASK_DEBUG=false

# ── Scenario feature flag ─────────────────────────────────────────────────────
# Set to true after the ETL data load (Phase 5) completes. Enables scenario creation.
SCENARIO_CREATION_ENABLED=true

# ── ETL API credentials ───────────────────────────────────────────────────────
# Only needed when running the loader (deploy/scripts/loader.sh) or ETL ingest commands.
# Not needed by the web or celery_worker services at runtime.
CDS_API_KEY=
EARTHDATA_TOKEN=
OPENTOPOGRAPHY_API_KEY=
